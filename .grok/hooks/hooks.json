{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "new|load|startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${GROK_WORKSPACE_ROOT}/.grok/hooks/session-start.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GROK_WORKSPACE_ROOT}/.grok/hooks/guard-bash.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
